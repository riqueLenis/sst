# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend MySQL local
HOST=0.0.0.0
PORT=4000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=lenis
MYSQL_DATABASE=sst
MYSQL_CONNECTION_LIMIT=10
MYSQL_AUTO_CREATE_DATABASE=true
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://exingroup.com.br,https://www.exingroup.com.br,https://api.exingroup.com.br
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
BODY_LIMIT=12mb
AUTH_COOKIE_NAME=sst_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Admin inicial criado apenas quando o banco está sem usuários.
# Troque a senha após o primeiro login em produção.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Exin@2025Admin
BOOTSTRAP_ADMIN_NAME=Administrador EXIN

# Frontend -> backend
# Deixe VITE_API_BASE_URL vazio para usar localhost no ambiente local
# e https://api.exingroup.com.br fora do localhost.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:4000
