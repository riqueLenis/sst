# =============================================================================
# Configuração de PRODUÇÃO do backend EXIN (api.exingroup.com.br)
# -----------------------------------------------------------------------------
# 1. Copie este arquivo para `.env` no servidor de produção.
# 2. Ajuste os valores do MySQL para o banco criado no painel (cPanel/VPS).
# 3. NUNCA versione o `.env` real (ele já está no .gitignore).
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# --- Banco de dados MySQL (use o usuário/banco criados no painel, não `root`) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=troque_pelo_usuario_do_painel
MYSQL_PASSWORD=troque_pela_senha_do_painel
MYSQL_DATABASE=troque_pelo_banco_do_painel
MYSQL_CONNECTION_LIMIT=10
# Em produção o banco geralmente já existe no painel; deixe desligado.
MYSQL_AUTO_CREATE_DATABASE=false

# --- Segurança / rede ---
# Ligue quando o backend estiver atrás de um proxy reverso (Apache/LiteSpeed/Nginx).
# Necessário para o rate-limit e o cookie Secure funcionarem com HTTPS.
TRUST_PROXY=true
CORS_ORIGIN=https://exingroup.com.br,https://www.exingroup.com.br,https://api.exingroup.com.br
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
BODY_LIMIT=12mb

# --- Cookie de sessão (HttpOnly) ---
AUTH_COOKIE_NAME=sst_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=strict

# --- JWT (gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_SECRET=_JCEFDD_EI0_1RAcWn26wMlq7jqGhmHxiPZEtfC_zdvzGsPjLdq25Ky4JoUDSkP4
JWT_EXPIRES_IN=8h

# --- Admin inicial (criado apenas quando o banco está sem usuários) ---
# Troque a senha após o primeiro login. Para desligar a criação automática: BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Exin@2025Admin
BOOTSTRAP_ADMIN_NAME=Administrador EXIN

# --- Frontend -> backend ---
# Em produção o frontend detecta api.exingroup.com.br automaticamente fora do localhost.
# Defina abaixo apenas se quiser forçar outra URL de API.
VITE_API_BASE_URL=
